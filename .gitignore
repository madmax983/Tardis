# Tardis OS - Git Ignore

# ============================================================================
# Rust / Cargo
# ============================================================================

# Build output
/target/
**/target/

# Cargo lock for library crates (keep for binaries/workspaces)
# We keep Cargo.lock for reproducible builds
# Cargo.lock

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows debugger
*.pdb

# ============================================================================
# IDE / Editor
# ============================================================================

# VSCode
.vscode/
*.code-workspace

# IntelliJ / CLion / RustRover
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# ============================================================================
# OS Files
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
*.lnk

# Linux
*~

# ============================================================================
# Build Artifacts
# ============================================================================

# Kernel build artifacts
*.bin
*.elf
*.iso
*.img

# QEMU disk images
*.qcow2
*.raw

# ============================================================================
# Dependencies / External
# ============================================================================

# Downloaded models (large files)
/models/
*.gguf
*.safetensors
*.bin
!src/**/*.bin

# CUDA compilation
*.ptx
*.cubin
*.fatbin

# ============================================================================
# Testing / Coverage
# ============================================================================

# Coverage reports
/coverage/
*.lcov
*.gcov
*.gcda
*.gcno
tarpaulin-report.html

# Benchmark results
/bench-results/
criterion/

# ============================================================================
# Documentation
# ============================================================================

# Generated documentation
/doc/
/target/doc/

# ============================================================================
# Local Configuration
# ============================================================================

# Local environment overrides
.env
.env.local
.env.*.local

# Local settings
.local/
*.local.toml

# Secrets (never commit!)
secrets/
*.key
*.pem
*.cert

# ============================================================================
# Logs / Temp
# ============================================================================

# Log files
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# ============================================================================
# Project Specific
# ============================================================================

# GallifreyDB data directory
/data/gallifrey/

# Model cache
/cache/
.cache/

# Runtime state (for development)
/state/

# Claude plans (local planning files)
.claude/plans/
settings.local.json
